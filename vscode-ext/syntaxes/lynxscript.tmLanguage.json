{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "LynxScript",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#booleans"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#cwscripts"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"attributes": {
			"patterns": [
				{
					"name": "meta.attribute.lynxscript",
					"begin": "#\\[",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.attribute.begin.lynxscript"
						}
					},
					"end": "\\]",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.attribute.end.lynxscript"
						}
					},
					"patterns": [
						{
							"name": "meta.attribute.lynxscript",
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
						},
						{
							"include": "#strings"
						}
					]
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.lynxscript",
					"begin": "//",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.lynxscript"
						}
					},
					"end": "$"
				}
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.lynxscript",
				"match": "\\b(if|while|for|return)\\b"
			},
			{
				"name": "keyword.declaration.lynxscript",
				"match": "\\b(function|let|link)\\b"
			}]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.lynxscript",
					"match": "\\*\\*|[+\\-*/=.,!]"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.boolean.lynxscript",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.lynxscript",
					"match": "\\b\\d+\\.\\d+\\b"
				},
				{
					"name": "constant.numeric.integer.lynxscript",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.lynxscript",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.lynxscript",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.raw.lynxscript",
					"begin": "#\"",
					"end": "\""
				}
			]
		},
		"cwscripts": {
			"patterns": [
				{
					"name": "constant.numeric.integer.cwscript.lynxscript",
					"match": "#\\d+"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "meta.function.declaration.lynxscript",
					"match": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
					"captures": {
						"1": {
							"name": "entity.name.function.lynxscript"
						}
					}
				},
				{
					"name": "entity.name.function.lynxscript",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.identifier.lynxscript",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		}
	},
	"scopeName": "source.lxs"
}